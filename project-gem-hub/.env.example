# Production: Supabase Connect -> Transaction pooler -> URI (port 6543).
# Store only in Netlify environment variables; never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Copy the real Netlify origin after the project is created; no trailing path.
APP_ORIGIN=https://YOUR_SITE.netlify.app
# Optional if the provider's certificate requires an explicit CA PEM.
DATABASE_CA_CERT=
# Only set to disable for a localhost PostgreSQL development database.
DATABASE_SSL=
# Only needed for a fresh database seed, not when importing existing users.
ADMIN_USERNAME=teacher
ADMIN_PASSWORD=
# Optional direct/session-mode connection for CLI migrations and imports.
MIGRATION_DATABASE_URL=
